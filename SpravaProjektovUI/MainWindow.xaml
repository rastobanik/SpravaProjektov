<Window x:Class="SpravaProjektovUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpravaProjektovUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        
        <DataGrid Grid.Column="0"
                  ItemsSource="{Binding Projects}"
                  AutoGenerateColumns="True"
                  SelectedItem="{Binding SelectedProject}"
                  Margin="10"
                  CanUserAddRows="False"
                  IsReadOnly="True"/>
        
        <StackPanel Grid.Column="1"
                    Margin="10"
                    VerticalAlignment="Top">

            <Button Content="Pridat" Command="{Binding PridatCommand}" Margin="0,0,0,10"/>
            <Button Content="Editovať" Command="{Binding AktualizovatCommand}" Margin="0,0,0,10"/>
            <Button Content="Zmazať" Command="{Binding ZmazatCommand}" Margin="0,0,0,10"/>
        </StackPanel>

    </Grid>
</Window>
