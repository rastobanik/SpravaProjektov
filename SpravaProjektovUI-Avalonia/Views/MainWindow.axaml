<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpravaProjektovUI_Avalonia.ViewModels"
        xmlns:views="using:SpravaProjektovUI_Avalonia.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SpravaProjektovUI_Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Správa Projektov"
        WindowStartupLocation="CenterScreen"
        MinWidth="600"
        MinHeight="400"
        Width="800"
        Height="500"
        >    

    <!-- Slovník šablón: Hovorí aplikácii, ktorý View patrí ku ktorému ViewModelu -->
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MainDashboardViewModel}">
            <views:MainDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectEditorViewModel}">
            <views:ProjectEditorView />
        </DataTemplate>
    </Window.DataTemplates>

    <!-- Tento prvok dynamicky zobrazí to, čo je momentálne v MainViewModel.CurrentPage -->
    <ContentControl Content="{Binding CurrentPage}" />

</Window>
